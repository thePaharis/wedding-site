DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5432/wedding_site
# Used only by npm run admin:create. Remove ADMIN_PASSWORD after account creation.
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=choose-a-unique-password-at-least-14-characters

# Email previews work with sending disabled.
SITE_URL=http://localhost:3000
EMAIL_SENDING_ENABLED=false
AWS_REGION=us-east-1
SES_FROM_EMAIL=you@example.com
# Generate once with npm run email:key, then store securely and back up.
INVITATION_ENCRYPTION_KEY=
# Use AWS_PROFILE with credentials configured locally by AWS CLI, or an IAM role in AWS.
# Never use root account credentials or commit AWS keys.
